<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp">


            <!-- ProgressBar -->

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
            <!-- Other UI elements, initially hidden -->
    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.336">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@color/vocabCardColor"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- English Word -->
                <TextView
                    android:id="@+id/tvDetailEnglishWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/english_word"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Emoji -->
                <TextView
                    android:id="@+id/tvEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="@string/emoji"
                    android:textSize="24sp" />

                <!-- Phonetic -->
                <TextView
                    android:id="@+id/tvPhonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="@string/tvphonetic"
                    android:textSize="18sp" />

            </LinearLayout>

            <!-- Remaining content below -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Turkish Word -->
                <TextView
                    android:id="@+id/tvDetailTurkishWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:text="@string/turkish_word"
                    android:textSize="20sp" />

                <!-- German Word -->
                <TextView
                    android:id="@+id/tvGermanWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:text="@string/german_word"
                    android:textSize="18sp" />

                <!-- Italian Word -->
                <TextView
                    android:id="@+id/tvItalianWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:text="@string/italian_word"
                    android:textSize="18sp" />

                <!-- Spanish Word -->
                <TextView
                    android:id="@+id/tvSpanishWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:text="@string/spanish_word"
                    android:textSize="18sp" />

                <!-- French Word -->
                <TextView
                    android:id="@+id/tvFrenchWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:text="@string/french_word"
                    android:textSize="18sp" />

                <!-- Definitions -->
                <TextView
                    android:id="@+id/tvDefinitions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:text="@string/definitions" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/pronunciationLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- English Pronunciation TextView -->
            <TextView
                android:id="@+id/tvEnglishPronunciation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="@string/listen_english_pronunciation"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- LinearLayout with Button and LottieAnimationView -->
            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPlayAudio"
                    android:layout_width="60dp"
                    android:layout_height="55dp"
                    android:background="@drawable/playcircle" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottiePlayAnimation"
                    android:layout_width="200dp"
                    android:layout_height="190dp"
                    android:layout_marginStart="50dp"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/audio" />
            </LinearLayout>

            <!-- Button below the animation -->


        </LinearLayout>

        <Button
            android:id="@+id/learnedButton"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="-20dp"
            android:backgroundTint="@color/navBarColor"
            android:gravity="center"
            android:text="@string/learned" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
